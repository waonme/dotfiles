# ~/.wslconfig の型（WSL2 の仮想マシン設定）
# PC ごとの値は非公開の dotfiles-hosts/<COMPUTERNAME>/.wslconfig に置く。setup.ps1 はそちらを配り、
# まだ無い PC にだけこの型を配る（値を直したら backup-hosts.cmd をダブルクリックして保存する）
# 変更後: wsl --shutdown で反映

[wsl2]
# PC ごとの値。物理の半分くらいを目安に、コメントを外して決める
# memory=16GB
# swap=8GB
# processors=8
# Windows ↔ Linux 間のファイル共有を virtiofs で（9P より速い）
virtiofs=true

[general]
# アイドルでもインスタンスを止めない（-1 = 無期限。既定は 60000 ms）
instanceIdleTimeout=-1
