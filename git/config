# ~/dotfiles/git/config — 全 PC 共通の Git 設定
# 使い方: git config --global --add include.path ~/dotfiles/git/config （setup.sh / setup.ps1 / setup-macos.sh が行う）
# user.name / user.email と署名鍵はここに書かない（このリポジトリは公開）。~/.gitconfig に直接書く
# core.autocrlf も OS ごとに違うので各 setup スクリプトが ~/.gitconfig に書く

[alias]
	st = status --short --branch
	co = checkout
	sw = switch
	br = branch -vv
	ci = commit
	ca = commit --amend --no-edit
	cm = commit -m
	df = diff
	dc = diff --cached
	lg = log --graph --abbrev-commit --decorate --format=format:'%C(yellow)%h%C(reset) %C(green)%ar%C(reset) %C(bold blue)%an%C(reset)%C(auto)%d%C(reset) %s' --all
	last = log -1 HEAD --stat
	unstage = reset HEAD --
	undo = reset --soft HEAD~1
	wip = !git add -A && git commit -m "wip"
	aliases = config --get-regexp ^alias\\.

[core]
	pager = delta
	# 全 PC 共通の無視ファイル（OS が作るゴミ）。無ければ無視される
	excludesFile = ~/dotfiles/git/ignore

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	side-by-side = false
	hyperlinks = false

[diff]
	colorMoved = default
	algorithm = histogram

[merge]
	conflictStyle = zdiff3

[pull]
	rebase = true

[rebase]
	autoStash = true
	autoSquash = true

[rerere]
	enabled = true
	autoUpdate = true

[fetch]
	prune = true

[push]
	default = current
	autoSetupRemote = true

[init]
	defaultBranch = main

[branch]
	sort = -committerdate

[column]
	ui = auto
